# ─────────────────────────────────────────────────────────
#  Finance Follow-Up Agent — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── LLM (Anthropic Claude) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=1024

# ── Email Delivery ────────────────────────────────────────
# Options: dry_run | smtp | sendgrid
EMAIL_MODE=dry_run

# SMTP settings (used when EMAIL_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SendGrid (used when EMAIL_MODE=sendgrid)
SENDGRID_API_KEY=SG.your-key-here

# Sender identity
FROM_EMAIL=finance@yourcompany.com
FROM_NAME=Finance Team

# ── Data Source ───────────────────────────────────────────
DATA_FILE=data/sample_invoices.csv

# ── Audit Storage ─────────────────────────────────────────
AUDIT_DB=logs/audit.db
AUDIT_JSON=logs/audit_log.json

# ── Company Info ──────────────────────────────────────────
COMPANY_NAME=Acme Corp
COMPANY_PHONE=+91-11-2345-6789
COMPANY_EMAIL=finance@yourcompany.com
